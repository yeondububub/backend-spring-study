direction: down

flow: "" {
  style.stroke: "transparent"
  style.fill: "transparent"
  direction: right
  controller: "Controller (Web)" {
    style.fill: "#E8F4FD"
    style.stroke: "#2B7DE9"
    style.border-radius: 8
  }
  service: "Service (비즈니스/트랜잭션)" {
    style.fill: "#E8F8F0"
    style.stroke: "#27AE60"
    style.border-radius: 8
  }
  repo: "Repository (JPA / EM)" {
    style.fill: "#FFF4E5"
    style.stroke: "#E67E22"
    style.border-radius: 8
  }
  db: "DB" {
    shape: cylinder
    style.fill: "#F5F7FA"
    style.stroke: "#5C6B73"
  }
  controller -> service -> repo -> db
}

domain: "Domain (엔티티 계층 - 모든 계층에서 참조)" {
  style.fill: "#F4ECF7"
  style.stroke: "#8E44AD"
  style.border-radius: 8
}

flow.controller -> domain
flow.service -> domain
flow.repo -> domain
