grid-columns: 2
grid-gap: 30

sql_mapper: "SQL Mapper 기술" {
  style.fill: "#FFF4E5"
  style.stroke: "#E67E22"
  style.border-radius: 8
  jdbc: "JdbcTemplate"
  mybatis: "MyBatis"
}

orm: "ORM 기술" {
  style.fill: "#E8F4FD"
  style.stroke: "#2B7DE9"
  style.border-radius: 8
  jpa: "JPA (표준) / Hibernate (구현체)"
  sdj: "스프링 데이터 JPA"
  qdsl: "Querydsl"
}
