direction: down

detached: "준영속 엔티티 (member)\n\"회원명변경\"" {
  style.fill: "#FFF4E5"
  style.stroke: "#E67E22"
  style.border-radius: 8
}

pc: "영속성 컨텍스트 (EntityManager)" {
  style.fill: "#F5F7FA"
  style.stroke: "#5C6B73"
  style.border-radius: 8
  cache: "1차 캐시" {
    style.fill: "#E8F4FD"
    style.stroke: "#2B7DE9"
    style.border-radius: 6
  }
  managed: "mergeMember (영속 상태)\n모든 필드 값 교체됨" {
    style.fill: "#E8F8F0"
    style.stroke: "#27AE60"
    style.border-radius: 6
  }
}

db: "DB" {
  shape: cylinder
  style.fill: "#F5F7FA"
  style.stroke: "#5C6B73"
}

detached -> pc.cache: "1. em.merge(member) -> 1차 캐시 조회"
pc.cache -> db: "2. 없으면 DB 조회"
detached -> pc.managed: "3. 준영속 값으로 모두 교체 (null 덮어쓰기 주의)"
