direction: right

java: "객체 (Java)" {
  style.fill: "#E8F4FD"
  style.stroke: "#2B7DE9"
  style.border-radius: 8
  ref: "참조를 통한 연관관계 탐색"
  inh: "상속 구조 (다형성)"
  id: "메모리 주소값 동일성 (==)"
}

rdb: "관계형 DB (RDB)" {
  style.fill: "#FFF4E5"
  style.stroke: "#E67E22"
  style.border-radius: 8
  fk: "외래 키(FK)와 JOIN을 통한 조회"
  sub: "슈퍼타입 서브타입 모델"
  pk: "PK(기본키) 기준 행 구분"
}

java <-> rdb: "패러다임 불일치"
